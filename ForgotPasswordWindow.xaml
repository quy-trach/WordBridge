<Window x:Class="WordBridge.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quên mật khẩu" 
        Icon="/img/reset-password.png"
        Height="550" 
        Width="400" 
        ResizeMode="NoResize" 
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA">
    <Grid Margin="30">
        <StackPanel>
            <!-- Tiêu đề -->
            <TextBlock Text="Đặt lại mật khẩu" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="#2B2D42" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,20"/>

            <!-- Email -->
            <TextBlock Text="Email:" 
                       FontSize="14" 
                       FontWeight="SemiBold" 
                       Foreground="#2B2D42" 
                       Margin="0,0,0,5"/>
            <TextBox x:Name="txtEmail" 
                     Height="40" 
                     Margin="0,5,0,15" 
                     Padding="10,0" 
                     FontSize="14"
                     BorderThickness="1"
                     BorderBrush="#D1D5DB"
                     Background="#FFFFFF"
                     VerticalContentAlignment="Center">
                <TextBox.Effect>
                    <DropShadowEffect ShadowDepth="2" 
                                      Direction="270" 
                                      Color="#D1D5DB" 
                                      BlurRadius="5" 
                                      Opacity="0.3"/>
                </TextBox.Effect>
                <TextBox.Resources>
                    <Style TargetType="TextBox">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TextBox">
                                    <Border CornerRadius="5" 
                                            Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <ScrollViewer x:Name="PART_ContentHost"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <!-- Nút gửi mã xác nhận -->
            <Button x:Name="btnSendCode" 
                    Content="Gửi mã xác nhận" 
                    Width="160" 
                    Height="40" 
                    Margin="0,0,0,15" 
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="#FFFFFF"
                    Background="#3B82F6"
                    BorderThickness="0"
                    Click="BtnSendCode_Click"
                    HorizontalAlignment="Center">
                <Button.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="5" 
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#2563EB"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Resources>
                <Button.Effect>
                    <DropShadowEffect ShadowDepth="2" 
                                      Direction="270" 
                                      Color="#D1D5DB" 
                                      BlurRadius="5" 
                                      Opacity="0.3"/>
                </Button.Effect>
            </Button>

            <!-- Mã xác nhận -->
            <TextBlock Text="Mã xác nhận:" 
                       FontSize="14" 
                       FontWeight="SemiBold" 
                       Foreground="#2B2D42" 
                       Margin="0,0,0,5"/>
            <TextBox x:Name="txtVerificationCode" 
                     Height="40" 
                     Margin="0,5,0,15" 
                     Padding="10,0" 
                     FontSize="14"
                     BorderThickness="1"
                     BorderBrush="#D1D5DB"
                     Background="#FFFFFF"
                     VerticalContentAlignment="Center">
                <TextBox.Effect>
                    <DropShadowEffect ShadowDepth="2" 
                                      Direction="270" 
                                      Color="#D1D5DB" 
                                      BlurRadius="5" 
                                      Opacity="0.3"/>
                </TextBox.Effect>
                <TextBox.Resources>
                    <Style TargetType="TextBox">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TextBox">
                                    <Border CornerRadius="5" 
                                            Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <ScrollViewer x:Name="PART_ContentHost"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <!-- Nút xác nhận mã -->
            <Button x:Name="btnVerifyCode" 
                    Content="Xác nhận mã" 
                    Width="160" 
                    Height="40" 
                    Margin="0,0,0,15" 
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="#FFFFFF"
                    Background="#3B82F6"
                    BorderThickness="0"
                    Click="BtnVerifyCode_Click"
                    HorizontalAlignment="Center">
                <Button.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="5" 
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#2563EB"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Resources>
                <Button.Effect>
                    <DropShadowEffect ShadowDepth="2" 
                                      Direction="270" 
                                      Color="#D1D5DB" 
                                      BlurRadius="5" 
                                      Opacity="0.3"/>
                </Button.Effect>
            </Button>

            <!-- Mật khẩu mới (ẩn ban đầu) -->
            <StackPanel x:Name="passwordPanel" Visibility="Collapsed">
                <TextBlock Text="Mật khẩu mới:" 
                           FontSize="14" 
                           FontWeight="SemiBold" 
                           Foreground="#2B2D42" 
                           Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtNewPassword" 
                             Height="40" 
                             Margin="0,5,0,15" 
                             Padding="10,0" 
                             FontSize="14"
                             BorderThickness="1"
                             BorderBrush="#D1D5DB"
                             Background="#FFFFFF"
                             VerticalContentAlignment="Center">
                    <PasswordBox.Effect>
                        <DropShadowEffect ShadowDepth="2" 
                                          Direction="270" 
                                          Color="#D1D5DB" 
                                          BlurRadius="5" 
                                          Opacity="0.3"/>
                    </PasswordBox.Effect>
                    <PasswordBox.Resources>
                        <Style TargetType="PasswordBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="PasswordBox">
                                        <Border CornerRadius="5" 
                                                Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ScrollViewer x:Name="PART_ContentHost"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </PasswordBox.Resources>
                </PasswordBox>

                <!-- Nút đặt lại mật khẩu -->
                <Button x:Name="btnResetPassword" 
                        Content="Đặt lại mật khẩu" 
                        Width="160" 
                        Height="40" 
                        Margin="0,0,0,15" 
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#FFFFFF"
                        Background="#3B82F6"
                        BorderThickness="0"
                        Click="BtnResetPassword_Click"
                        HorizontalAlignment="Center">
                    <Button.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="5" 
                                                Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2563EB"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Resources>
                    <Button.Effect>
                        <DropShadowEffect ShadowDepth="2" 
                                          Direction="270" 
                                          Color="#D1D5DB" 
                                          BlurRadius="5" 
                                          Opacity="0.3"/>
                    </Button.Effect>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
