<Window x:Class="WordBridge.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng ký tài khoản" 
        Icon="/img/verify.png"
        Height="650" 
        Width="450" 
        ResizeMode="NoResize" 
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Tiêu đề -->
            <RowDefinition Height="Auto"/>
            <!-- Label Tên đăng nhập -->
            <RowDefinition Height="Auto"/>
            <!-- TextBox Tên đăng nhập -->
            <RowDefinition Height="Auto"/>
            <!-- Label Họ tên -->
            <RowDefinition Height="Auto"/>
            <!-- TextBox Họ tên -->
            <RowDefinition Height="Auto"/>
            <!-- Label Email -->
            <RowDefinition Height="Auto"/>
            <!-- TextBox Email -->
            <RowDefinition Height="Auto"/>
            <!-- Label Mật khẩu -->
            <RowDefinition Height="Auto"/>
            <!-- PasswordBox Mật khẩu -->
            <RowDefinition Height="Auto"/>
            <!-- Label Xác nhận -->
            <RowDefinition Height="Auto"/>
            <!-- PasswordBox Xác nhận -->
            <RowDefinition Height="*"/>
            <!-- Nút -->
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <TextBlock Text="Đăng ký tài khoản" 
                   Grid.Row="0"
                   FontSize="24" 
                   FontWeight="Bold" 
                   Foreground="#2B2D42" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <!-- Tên đăng nhập -->
        <TextBlock Text="Tên đăng nhập:" 
                   Grid.Row="1" 
                   FontSize="14" 
                   FontWeight="SemiBold" 
                   Foreground="#2B2D42" 
                   Margin="0,0,0,5"/>
        <TextBox x:Name="txtUsername" 
                 Grid.Row="2" 
                 Height="40" 
                 Margin="0,5,0,15" 
                 Padding="10,0" 
                 FontSize="14"
                 BorderThickness="1"
                 BorderBrush="#D1D5DB"
                 Background="#FFFFFF"
                 VerticalContentAlignment="Center">
            <TextBox.Effect>
                <DropShadowEffect ShadowDepth="2" 
                                Direction="270" 
                                Color="#D1D5DB" 
                                BlurRadius="5" 
                                Opacity="0.3"/>
            </TextBox.Effect>
            <TextBox.Resources>
                <Style TargetType="TextBox">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TextBox">
                                <Border CornerRadius="5" 
                                        Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ScrollViewer x:Name="PART_ContentHost"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TextBox.Resources>
        </TextBox>

        <!-- Họ tên -->
        <TextBlock Text="Họ tên:" 
                   Grid.Row="3" 
                   FontSize="14" 
                   FontWeight="SemiBold" 
                   Foreground="#2B2D42" 
                   Margin="0,0,0,5"/>
        <TextBox x:Name="txtFullname" 
                 Grid.Row="4" 
                 Height="40" 
                 Margin="0,5,0,15" 
                 Padding="10,0" 
                 FontSize="14"
                 BorderThickness="1"
                 BorderBrush="#D1D5DB"
                 Background="#FFFFFF"
                 VerticalContentAlignment="Center">
            <TextBox.Effect>
                <DropShadowEffect ShadowDepth="2" Direction="270" Color="#D1D5DB" BlurRadius="5" Opacity="0.3"/>
            </TextBox.Effect>
            <TextBox.Resources>
                <Style TargetType="TextBox">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TextBox">
                                <Border CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                    <ScrollViewer x:Name="PART_ContentHost"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TextBox.Resources>
        </TextBox>

        <!-- Email -->
        <TextBlock Text="Email:" 
                   Grid.Row="5" 
                   FontSize="14" 
                   FontWeight="SemiBold" 
                   Foreground="#2B2D42" 
                   Margin="0,0,0,5"/>
        <TextBox x:Name="txtEmail" 
                 Grid.Row="6" 
                 Height="40" 
                 Margin="0,5,0,15" 
                 Padding="10,0" 
                 FontSize="14"
                 BorderThickness="1"
                 BorderBrush="#D1D5DB"
                 Background="#FFFFFF"
                 VerticalContentAlignment="Center">
            <TextBox.Effect>
                <DropShadowEffect ShadowDepth="2" Direction="270" Color="#D1D5DB" BlurRadius="5" Opacity="0.3"/>
            </TextBox.Effect>
            <TextBox.Resources>
                <Style TargetType="TextBox">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TextBox">
                                <Border CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                    <ScrollViewer x:Name="PART_ContentHost"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TextBox.Resources>
        </TextBox>

        <!-- Mật khẩu -->
        <TextBlock Text="Mật khẩu:" 
                   Grid.Row="7" 
                   FontSize="14" 
                   FontWeight="SemiBold" 
                   Foreground="#2B2D42" 
                   Margin="0,0,0,5"/>
        <PasswordBox x:Name="txtPassword" 
                     Grid.Row="8" 
                     Height="40" 
                     Margin="0,5,0,15" 
                     Padding="10,0" 
                     FontSize="14"
                     BorderThickness="1"
                     BorderBrush="#D1D5DB"
                     Background="#FFFFFF"
                     VerticalContentAlignment="Center">
            <PasswordBox.Effect>
                <DropShadowEffect ShadowDepth="2" 
                                Direction="270" 
                                Color="#D1D5DB" 
                                BlurRadius="5" 
                                Opacity="0.3"/>
            </PasswordBox.Effect>
            <PasswordBox.Resources>
                <Style TargetType="PasswordBox">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="PasswordBox">
                                <Border CornerRadius="5" 
                                        Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ScrollViewer x:Name="PART_ContentHost"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </PasswordBox.Resources>
        </PasswordBox>

        <!-- Xác nhận mật khẩu -->
        <TextBlock Text="Xác nhận mật khẩu:" 
                   Grid.Row="9" 
                   FontSize="14" 
                   FontWeight="SemiBold" 
                   Foreground="#2B2D42" 
                   Margin="0,0,0,5"/>
        <PasswordBox x:Name="txtConfirmPassword" 
                     Grid.Row="10" 
                     Height="40" 
                     Margin="0,5,0,20" 
                     Padding="10,0" 
                     FontSize="14"
                     BorderThickness="1"
                     BorderBrush="#D1D5DB"
                     Background="#FFFFFF"
                     VerticalContentAlignment="Center">
            <PasswordBox.Effect>
                <DropShadowEffect ShadowDepth="2" 
                                Direction="270" 
                                Color="#D1D5DB" 
                                BlurRadius="5" 
                                Opacity="0.3"/>
            </PasswordBox.Effect>
            <PasswordBox.Resources>
                <Style TargetType="PasswordBox">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="PasswordBox">
                                <Border CornerRadius="5" 
                                        Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ScrollViewer x:Name="PART_ContentHost"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </PasswordBox.Resources>
        </PasswordBox>

        <!-- Nút điều khiển -->
        <StackPanel Grid.Row="11" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom">
            <Button Content="Đăng ký" 
                    Width="120" 
                    Height="40" 
                    Margin="5" 
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="#FFFFFF"
                    Background="#3B82F6"
                    BorderThickness="0"
                    Click="BtnRegister_Click">
                <Button.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="5" 
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#2563EB"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Resources>
                <Button.Effect>
                    <DropShadowEffect ShadowDepth="2" 
                                    Direction="270" 
                                    Color="#D1D5DB" 
                                    BlurRadius="5" 
                                    Opacity="0.3"/>
                </Button.Effect>
            </Button>
            <Button Content="Hủy" 
                    Width="120" 
                    Height="40" 
                    Margin="5" 
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="#2B2D42"
                    Background="#E5E7EB"
                    BorderThickness="0"
                    Click="BtnCancel_Click">
                <Button.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="5" 
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#D1D5DB"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Resources>
                <Button.Effect>
                    <DropShadowEffect ShadowDepth="2" 
                                    Direction="270" 
                                    Color="#D1D5DB" 
                                    BlurRadius="5" 
                                    Opacity="0.3"/>
                </Button.Effect>
            </Button>
        </StackPanel>
    </Grid>
</Window>